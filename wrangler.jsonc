{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentqueue",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "agentqueue.simon-lehmann.com", "custom_domain": true }],
  "assets": { "directory": "./public", "run_worker_first": ["/p/*", "/health"] },
  "artifacts": [
    // remote: Artifacts has no local emulator; dev talks to the real service
    { "binding": "ARTIFACTS", "namespace": "agentqueue", "remote": true }
  ],
  "ai": { "binding": "AI", "remote": true },
  "vars": { "DEMO_DAILY_LIMIT": "40" }, // one-click demos per day across all visitors
  "ratelimits": [{ "name": "DEMO_LIMIT", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } }],
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "RepoCoordinator" },
      { "name": "AGENT", "class_name": "SwarmAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["SwarmAgent"] }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentqueue",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [
    // remote: Artifacts has no local emulator; dev talks to the real service
    { "binding": "ARTIFACTS", "namespace": "agentqueue", "remote": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "COORDINATOR", "class_name": "RepoCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoCoordinator"] }]
}
